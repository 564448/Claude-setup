# Whitelist: ignore everything at the top level, then re-allow only the Claude setup.
/*
!/.gitignore
!/.gitattributes
!/CLAUDE.md
!/README.md
!/bootstrap.sh
!/skills-lock.json
!/.agents/
!/.claude/
!/user-claude/
!/claude-skills/

# .claude: skill symlinks are recreated by bootstrap.sh; local settings stay local
/.claude/skills/
/.claude/settings.local.json

# Python bytecode
__pycache__/
