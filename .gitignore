# Whitelist: ignore everything at the top level, then re-allow only the Claude setup.
/*
!/.gitignore
!/.gitattributes
!/CLAUDE.md
!/README.md
!/bootstrap.sh
!/skills-lock.json
!/.agents/
!/.claude/
!/user-claude/
!/Project/

# .claude: skill symlinks are recreated by bootstrap.sh; local settings stay local
/.claude/skills/
/.claude/settings.local.json

# Project: only the skills repo
/Project/*
!/Project/claude-skills/

# Python bytecode
__pycache__/
